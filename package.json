    "build:css": "tailwindcss -i input.css -o index.css --minify",
    "watch:css": "tailwindcss -i input.css -o index.css --watch",
    "test": "node tests/smoke.cjs && node tests/lan-turbo.cjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
